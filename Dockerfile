# 1. Используем легкий и быстрый образ Python
FROM python:3.11-slim

# 2. Указываем рабочую папку внутри «контейнера»
WORKDIR /app

# 3. Копируем файл со списком библиотек
COPY requirements.txt .

# 4. Устанавливаем все нужные библиотеки
RUN pip install --no-cache-dir -r requirements.txt

# 5. Копируем все остальные файлы твоего проекта
COPY . .

# 6. Команда, которая запустит бота при старте контейнера
CMD ["python", "main.py"]